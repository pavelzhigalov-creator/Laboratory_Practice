   7:Core/Src/mpu6050.c **** 
   8:Core/Src/mpu6050.c **** // Инициализация I2C1 с любой частотой
   9:Core/Src/mpu6050.c **** void I2C1_Init(uint32_t i2c_speed_khz) {
  10:Core/Src/mpu6050.c ****     uint32_t apb1_freq = get_apb1_frequency();
  11:Core/Src/mpu6050.c ****     uint32_t ccr_value;
  12:Core/Src/mpu6050.c ****     
  13:Core/Src/mpu6050.c ****     // Включаем тактирование
  14:Core/Src/mpu6050.c ****     RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
  15:Core/Src/mpu6050.c ****     RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;
  16:Core/Src/mpu6050.c ****     
  17:Core/Src/mpu6050.c ****     // Настройка PB8 (SCL) и PB9 (SDA)
  18:Core/Src/mpu6050.c ****     GPIOB->MODER &= ~(GPIO_MODER_MODER8 | GPIO_MODER_MODER9);
  19:Core/Src/mpu6050.c ****     GPIOB->MODER |= (2 << GPIO_MODER_MODER8_Pos) | (2 << GPIO_MODER_MODER9_Pos);
  20:Core/Src/mpu6050.c ****     GPIOB->OTYPER |= GPIO_OTYPER_OT_8 | GPIO_OTYPER_OT_9;
  21:Core/Src/mpu6050.c ****     GPIOB->PUPDR |= (1 << (2 * 8)) | (1 << (2 * 9));
  22:Core/Src/mpu6050.c ****     GPIOB->AFR[1] |= (4 << (4 * 0)) | (4 << (4 * 1));
  23:Core/Src/mpu6050.c ****     
  24:Core/Src/mpu6050.c ****     // Сброс I2C
  25:Core/Src/mpu6050.c ****     I2C1->CR1 &= ~I2C_CR1_PE;
  26:Core/Src/mpu6050.c ****     I2C1->CR1 = I2C_CR1_SWRST;
  27:Core/Src/mpu6050.c ****     I2C1->CR1 = 0;
  28:Core/Src/mpu6050.c ****     
  29:Core/Src/mpu6050.c ****     // Настройка частоты I2C
  30:Core/Src/mpu6050.c ****     I2C1->CR2 = (apb1_freq / 1000000) & I2C_CR2_FREQ;
  31:Core/Src/mpu6050.c ****     
  32:Core/Src/mpu6050.c ****     // Расчет CCR для Standard Mode (100 kHz)
  33:Core/Src/mpu6050.c ****     ccr_value = apb1_freq / (i2c_speed_khz * 2000);
  34:Core/Src/mpu6050.c ****     if(ccr_value < 4) ccr_value = 4;
  35:Core/Src/mpu6050.c ****     I2C1->CCR = ccr_value;
  36:Core/Src/mpu6050.c ****     
  37:Core/Src/mpu6050.c ****     // Расчет TRISE
  38:Core/Src/mpu6050.c ****     I2C1->TRISE = (apb1_freq / 1000000) + 1;
  39:Core/Src/mpu6050.c ****     
  40:Core/Src/mpu6050.c ****     // Включаем I2C
  41:Core/Src/mpu6050.c ****     I2C1->CR1 |= I2C_CR1_PE;
  42:Core/Src/mpu6050.c **** }
  43:Core/Src/mpu6050.c **** 
