  39:Core/Src/mpu6050.c **** //4- MPU6050 Initialaztion Configuration 
  40:Core/Src/mpu6050.c **** void MPU6050_Config(MPU_ConfigTypeDef *config)
  41:Core/Src/mpu6050.c **** {
  42:Core/Src/mpu6050.c **** 	uint8_t Buffer = 0;
  43:Core/Src/mpu6050.c **** 	//Clock Source 
  44:Core/Src/mpu6050.c **** 	//Reset Device
  45:Core/Src/mpu6050.c **** 
  46:Core/Src/mpu6050.c **** 	i2c_writeByte(MPU_ADDR, PWR_MAGT_1_REG, 0x80);
  47:Core/Src/mpu6050.c **** 
  48:Core/Src/mpu6050.c **** 	delay(100);
  49:Core/Src/mpu6050.c **** 
  50:Core/Src/mpu6050.c **** 	Buffer = config ->ClockSource & 0x07; //change the 7th bits of register
  51:Core/Src/mpu6050.c **** 
  52:Core/Src/mpu6050.c **** 	Buffer |= (config ->Sleep_Mode_Bit << 6) &0x40; // change only the 7th bit in the register
  53:Core/Src/mpu6050.c **** 	
  54:Core/Src/mpu6050.c **** 	i2c_writeByte(MPU_ADDR,PWR_MAGT_1_REG, Buffer);
  55:Core/Src/mpu6050.c **** 
  56:Core/Src/mpu6050.c **** 	delay(100); // should wait 10ms after changeing the clock setting.
  57:Core/Src/mpu6050.c **** 
  58:Core/Src/mpu6050.c **** 	//Set the Digital Low Pass Filter
  59:Core/Src/mpu6050.c **** 	Buffer = 0;
  60:Core/Src/mpu6050.c **** 
  61:Core/Src/mpu6050.c **** 	Buffer = config->CONFIG_DLPF & 0x07;
  62:Core/Src/mpu6050.c **** 	
  63:Core/Src/mpu6050.c **** 	i2c_writeByte(MPU_ADDR,CONFIG_REG, Buffer);
  64:Core/Src/mpu6050.c **** 
  65:Core/Src/mpu6050.c **** 	//Select the Gyroscope Full Scale Range
  66:Core/Src/mpu6050.c **** 	Buffer = 0;
  67:Core/Src/mpu6050.c **** 
  68:Core/Src/mpu6050.c **** 	Buffer = (config->Gyro_Full_Scale << 3) & 0x18;
  69:Core/Src/mpu6050.c **** 	
  70:Core/Src/mpu6050.c **** 	i2c_writeByte(MPU_ADDR,GYRO_CONFIG_REG, Buffer);
  71:Core/Src/mpu6050.c **** 
  72:Core/Src/mpu6050.c **** 	//Select the Accelerometer Full Scale Range 
  73:Core/Src/mpu6050.c **** 	Buffer = 0; 
  74:Core/Src/mpu6050.c **** 
  75:Core/Src/mpu6050.c **** 	Buffer = (config->Accel_Full_Scale << 3) & 0x18;
  76:Core/Src/mpu6050.c **** 
  77:Core/Src/mpu6050.c **** 	i2c_writeByte(MPU_ADDR,ACCEL_CONFIG_REG, Buffer);
  78:Core/Src/mpu6050.c **** 
  79:Core/Src/mpu6050.c **** 	//Set SRD To Default
  80:Core/Src/mpu6050.c **** 	MPU6050_Set_SMPRT_DIV(0x04);
  81:Core/Src/mpu6050.c **** 	
  82:Core/Src/mpu6050.c **** 	
  83:Core/Src/mpu6050.c **** 	//Accelerometer Scaling Factor, Set the Accelerometer and Gyroscope Scaling Factor
  84:Core/Src/mpu6050.c **** 	switch (config->Accel_Full_Scale)
  85:Core/Src/mpu6050.c **** 	{
  86:Core/Src/mpu6050.c **** 		case AFS_SEL_2g:
  87:Core/Src/mpu6050.c **** 			accelScalingFactor = (2000.0f/32768.0f);
ARM GAS  C:\Users\pashk\AppData\Local\Temp\cczI5GQ8.s 			page 3


  88:Core/Src/mpu6050.c **** 			break;
  89:Core/Src/mpu6050.c **** 		
  90:Core/Src/mpu6050.c **** 		case AFS_SEL_4g:
  91:Core/Src/mpu6050.c **** 			accelScalingFactor = (4000.0f/32768.0f);
  92:Core/Src/mpu6050.c **** 				break;
  93:Core/Src/mpu6050.c **** 		
  94:Core/Src/mpu6050.c **** 		case AFS_SEL_8g:
  95:Core/Src/mpu6050.c **** 			accelScalingFactor = (8000.0f/32768.0f);
  96:Core/Src/mpu6050.c **** 			break;
  97:Core/Src/mpu6050.c **** 		
  98:Core/Src/mpu6050.c **** 		case AFS_SEL_16g:
  99:Core/Src/mpu6050.c **** 			accelScalingFactor = (16000.0f/32768.0f);
 100:Core/Src/mpu6050.c **** 			break;
 101:Core/Src/mpu6050.c **** 		
 102:Core/Src/mpu6050.c **** 		default:
 103:Core/Src/mpu6050.c **** 			break;
 104:Core/Src/mpu6050.c **** 	}
 105:Core/Src/mpu6050.c **** 	//Gyroscope Scaling Factor 
 106:Core/Src/mpu6050.c **** 	switch (config->Gyro_Full_Scale)
 107:Core/Src/mpu6050.c **** 	{
 108:Core/Src/mpu6050.c **** 		case FS_SEL_250:
 109:Core/Src/mpu6050.c **** 			gyroScalingFactor = 250.0f/32768.0f;
 110:Core/Src/mpu6050.c **** 			break;
 111:Core/Src/mpu6050.c **** 		
 112:Core/Src/mpu6050.c **** 		case FS_SEL_500:
 113:Core/Src/mpu6050.c **** 				gyroScalingFactor = 500.0f/32768.0f;
 114:Core/Src/mpu6050.c **** 				break;
 115:Core/Src/mpu6050.c **** 		
 116:Core/Src/mpu6050.c **** 		case FS_SEL_1000:
 117:Core/Src/mpu6050.c **** 			gyroScalingFactor = 1000.0f/32768.0f;
 118:Core/Src/mpu6050.c **** 			break;
 119:Core/Src/mpu6050.c **** 		
 120:Core/Src/mpu6050.c **** 		case FS_SEL_2000:
 121:Core/Src/mpu6050.c **** 			gyroScalingFactor = 2000.0f/32768.0f;
 122:Core/Src/mpu6050.c **** 			break;
 123:Core/Src/mpu6050.c **** 		
 124:Core/Src/mpu6050.c **** 		default:
 125:Core/Src/mpu6050.c **** 			break;
 126:Core/Src/mpu6050.c **** 	}
 127:Core/Src/mpu6050.c **** 	
 128:Core/Src/mpu6050.c **** }
